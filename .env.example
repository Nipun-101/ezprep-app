# API origin only. Do not append /api/v1.
# Local API listens on 3000. Run this app on 3001.
NEXT_PUBLIC_API_URL=http://localhost:3000

# MSG91 phone OTP widget (public browser values)
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=

# Google sign-in. Leave the client id empty to keep phone OTP only.
# Redirect must match Google Cloud and the API GOOGLE_REDIRECT_URIS exactly.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3001

# Razorpay Checkout.js key id only. Never put the key secret or webhook secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public brand and legal copy. These are not secrets. Defaults match EZ Prep when unset.
# Phone and grievance officer stay empty until go-live (GO_LIVE_GUIDE step 4).
NEXT_PUBLIC_BRAND_NAME=EzPrep
NEXT_PUBLIC_LEGAL_NAME=EzPrep - Powered by Clustream
NEXT_PUBLIC_LEGAL_ADDRESS=Kerala, India
NEXT_PUBLIC_SUPPORT_EMAIL=support@ezprep.in
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_LEGAL_JURISDICTION=Kochi, Kerala
